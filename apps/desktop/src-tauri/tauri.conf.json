{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linux Voice Typer",
  "version": "0.1.0",
  "identifier": "dev.linux-voice-typer.desktop",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "beforeBuildCommand": "npm run frontend:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Linux Voice Typer",
        "width": 1040,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Linux Voice Typer Overlay",
        "url": "overlay.html",
        "width": 240,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"]
  }
}
